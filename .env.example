# ==============================================================================
# Environment Configuration Template
# Copy to .env and configure for your local environment
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database path (optional - defaults to server/data/notes.db)
DB_PATH=./server/data/notes.db

# CORS Allowed Origins (comma-separated or * for wildcard)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Gemini API Key (optional AI Studio runtime secret)
GEMINI_API_KEY=""

# Application URL
APP_URL="http://localhost:3000"
